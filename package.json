{
    "name": "frappe-gantt",
    "version": "1.2.2",
    "description": "A simple, modern, interactive gantt library for the web",
    "main": "src/index.js",
    "style": "src/styles/gantt.css",
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "lint": "eslint src/**/*.js",
        "prettier": "prettier --write \"{src/**/,tests/*,rollup.config}.{js,css}\"",
        "prettier-check": "prettier --check \"{src/*,tests/*,rollup.config}.{js,css}\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frappe/gantt.git"
    },
    "files": [
        "src",
        "dist",
        "README.md"
    ],
    "exports": {
        ".": "./src/index.js",
        "./src/*": "./src/*"
    },
    "keywords": [
        "gantt",
        "svg",
        "simple gantt",
        "project timeline",
        "interactive gantt",
        "project management"
    ],
    "author": "Faris Ansari",
    "license": "MIT",
    "devDependencies": {
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^2.9.0",
        "eslint-plugin-prettier": "^2.6.0",
        "postcss-nesting": "^12.1.2",
        "prettier": "3.2.5",
        "vite": "4"
    },
    "sideEffects": [
        "*.css"
    ],
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
